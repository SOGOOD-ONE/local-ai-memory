{
  "manifest_version": 3,
  "name": "Local AI Cost Optimizer",
  "version": "0.8.5",
  "description": "本地 LLM 成本优化中间层",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Local AI Cost Optimizer",
    "default_popup": "popup/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/adapter.js",
        "content/send_bridge.js",
        "content/send_guard.js",
        "content/chatgpt_adapter_v2.js",
        "content/chatgpt_sender_v1.js",
        "content/request_context.js",
        "content/request_context_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": [
        "content/adapter.js",
        "content/send_bridge.js",
        "content/send_guard.js",
        "content/doubao_adapter_v2.js",
        "content/doubao_sender_v1.js",
        "content/request_context.js",
        "content/request_context_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.trea.ai/*",
        "https://trea.ai/*"
      ],
      "js": [
        "content/adapter.js",
        "content/send_bridge.js",
        "content/send_guard.js",
        "content/trea_adapter_v2.js",
        "content/trea_sender_v1.js",
        "content/request_context.js",
        "content/request_context_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*"
      ],
      "js": [
        "content/adapter.js",
        "content/send_bridge.js",
        "content/send_guard.js",
        "content/deepseek_adapter_v2.js",
        "content/deepseek_sender_v1.js",
        "content/request_context.js",
        "content/request_context_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tongyi.aliyun.com/*",
        "https://*.tongyi.aliyun.com/*",
        "https://qianwen.aliyun.com/*",
        "https://*.qianwenai.com/*"
      ],
      "js": [
        "content/adapter.js",
        "content/send_bridge.js",
        "content/send_guard.js",
        "content/qwen_adapter_v2.js",
        "content/qwen_sender_v1.js",
        "content/request_context.js",
        "content/request_context_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatglm.cn/*",
        "https://*.chatglm.cn/*",
        "https://www.chatglm.com/*",
        "https://*.chatglm.com/*"
      ],
      "js": [
        "content/adapter.js",
        "content/send_bridge.js",
        "content/send_guard.js",
        "content/chatglm_adapter_v2.js",
        "content/chatglm_sender_v1.js",
        "content/request_context.js",
        "content/request_context_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kimi.com/*",
        "https://*.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://*.kimi.moonshot.cn/*",
        "https://kimi.ai/*",
        "https://*.kimi.ai/*"
      ],
      "js": [
        "content/adapter.js",
        "content/send_bridge.js",
        "content/send_guard.js",
        "content/kimi_adapter_v2.js",
        "content/kimi_sender_v1.js",
        "content/request_context.js",
        "content/request_context_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
